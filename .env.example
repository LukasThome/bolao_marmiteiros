# =============================================================
# Bolão dos Marmiteiros — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores
# =============================================================

# ── Banco de dados ──────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bolao?retryWrites=true&w=majority"

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET="troque-por-uma-string-aleatoria-longa"
NEXTAUTH_URL="http://localhost:3000"

# ── Email (reset de senha via Resend) ───────────────────────
RESEND_API_KEY=""
# RESEND_FROM="Bolão dos Marmiteiros <noreply@seu-dominio.com>"

# ── Dev bypass (sem banco real) ──────────────────────────────
# Descomente para usar login automático em localhost
# DEV_USER_EMAIL="dev@bolao.local"
# DEV_USER_NAME="Dev Marmiteiro"
