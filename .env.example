# =============================================================
# Bolão dos Marmiteiros — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores
# =============================================================

# ── Banco de dados ──────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bolao?retryWrites=true&w=majority"

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET="troque-por-uma-string-aleatoria-longa"
NEXTAUTH_URL="http://localhost:3000"

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=""

# ── APIs de futebol (resultados) ────────────────────────────
# football-data.org (preferencial para Copa do Mundo 2026)
FOOTBALL_DATA_API_KEY=""
# RapidAPI / API-Football (fallback)
RAPIDAPI_KEY=""
# RESEND_FROM="Bolão dos Marmiteiros <noreply@seu-dominio.com>"

# ── Cron (sincronização automática de resultados) ───────────
# Secret que protege o endpoint /api/cron/sync-resultados.
# O Vercel Cron envia este valor no header Authorization.
# Gere uma string aleatória longa e configure também na Vercel.
CRON_SECRET=""

